GEMINI_API_KEY=your_key_from_aistudio.google.com

# Models
GEMINI_GENERATION_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# Paths
CHROMA_DB_PATH=./chroma_db
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
CACHE_DB_PATH=./cache.db

# Rate control (seconds between calls)
INGEST_TRANSLATION_SLEEP_SECONDS=0.05
EMBEDDING_SLEEP_SECONDS=0.2
RAG_GENERATION_SLEEP_SECONDS=4.2
QUESTION_GENERATION_SLEEP_SECONDS=4.2

# Batching
EMBEDDING_BATCH_SIZE=100
